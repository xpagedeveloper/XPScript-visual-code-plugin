{
  "name": "xpscript",
  "displayName": "XPscript",
  "description": "XPscript language support with repository-driven IntelliSense.",
  "version": "0.2.0",
  "publisher": "xpagedeveloper",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpagedeveloper/XPScript-visual-code-plugin.git"
  },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages", "Debuggers"],
  "activationEvents": [
    "onLanguage:xpscript",
    "onDebug:xpscript",
    "onCommand:xpscript.refreshApiIndex",
    "onCommand:xpscript.checkForUpdates"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "xpscript",
      "aliases": ["XPscript", "xpscript"],
      "extensions": [".xps", ".xpscript"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "xpscript",
      "scopeName": "source.xpscript",
      "path": "./syntaxes/xpscript.tmLanguage.json"
    }],
    "debuggers": [{
      "type": "xpscript",
      "label": "XPscript Debugger",
      "languages": ["xpscript"],
      "configurationAttributes": {
        "launch": {
          "required": ["program"],
          "properties": {
            "program": {
              "type": "string",
              "description": "XPscript source file to launch."
            },
            "target": {
              "type": "string",
              "enum": ["cli", "desktop", "web", "wasm"],
              "default": "cli",
              "description": "Runtime target to debug. Web and WASM currently use attach mode."
            },
            "stopOnEntry": {
              "type": "boolean",
              "default": false
            },
            "executable": {
              "type": "string",
              "description": "Optional XPscript CLI executable for this launch configuration."
            },
            "args": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Arguments appended after xpscript run <program>."
            }
          }
        },
        "attach": {
          "required": ["port"],
          "properties": {
            "target": {
              "type": "string",
              "enum": ["desktop", "web", "wasm"],
              "default": "web"
            },
            "host": {
              "type": "string",
              "default": "127.0.0.1"
            },
            "port": {
              "type": "number"
            },
            "token": {
              "type": "string",
              "description": "Ephemeral debugger authentication token."
            }
          }
        }
      },
      "initialConfigurations": [
        {
          "type": "xpscript",
          "request": "launch",
          "name": "Debug current XPscript file",
          "program": "${file}",
          "target": "cli",
          "stopOnEntry": false
        },
        {
          "type": "xpscript",
          "request": "attach",
          "name": "Attach to XPscript web/desktop runtime",
          "target": "web",
          "host": "127.0.0.1",
          "port": 4711
        }
      ]
    }],
    "commands": [
      { "command": "xpscript.refreshApiIndex", "title": "XPscript: Refresh API Index" },
      { "command": "xpscript.checkForUpdates", "title": "XPscript: Check for Updates" }
    ],
    "configuration": {
      "title": "XPscript",
      "properties": {
        "xpscript.runtimeRepoPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a local checkout of the XPscript repository."
        },
        "xpscript.indexWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Index XPscript declarations in the current workspace."
        },
        "xpscript.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub Releases for a newer XPscript extension when the extension starts. Installation always requires explicit approval."
        },
        "xpscript.debugExecutable": {
          "type": "string",
          "default": "xpscript",
          "description": "XPscript CLI executable used by debugger launch configurations."
        }
      }
    }
  },
  "scripts": {
    "generate:catalog": "node scripts/generate-catalog.mjs && node scripts/augment-catalog.mjs && node scripts/sync-current-public-api.mjs && node scripts/apply-astro-docs.mjs && node scripts/apply-parameter-help.mjs && node scripts/filter-removed-api.mjs",
    "compile": "npm run generate:catalog && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare:publish": "node -e \"require('fs').mkdirSync('publish',{recursive:true})\"",
    "package": "npm run compile && npm run prepare:publish && vsce package --out publish/xpscript.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
